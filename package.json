{
  "name": "market-mind",
  "version": "0.2.0",
  "description": "Read-only Polymarket API explorer with deterministic order-book analytics (educational project).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run coverage",
    "smoke": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "big.js": "7.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/big.js": "7.0.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
