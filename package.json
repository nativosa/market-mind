{
  "name": "market-mind",
  "version": "0.8.0",
  "description": "Read-only Polymarket research toolkit: order-book analytics, SQLite history, an MCP server and a Claude investigator (educational project).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "cli": "tsx src/cli/main.ts",
    "mcp": "node bin/marketmind-mcp.mjs",
    "web": "npm run web:build && node bin/marketmind-web.mjs",
    "web:serve": "node bin/marketmind-web.mjs",
    "web:dev": "node bin/marketmind-web-dev.mjs",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web",
    "agent": "tsx agent-sdk/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p web",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run coverage",
    "smoke": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "big.js": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "0.135.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/big.js": "7.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
